<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../USS/AppStyles.uss" />

    <ui:VisualElement name="screen-tangkapan" class="screen">

        <!-- Top Bar -->
        <ui:VisualElement class="top-bar" style="flex-shrink: 0;">
            <ui:Label name="btn-close" class="btn-back" />
            <ui:Label text="Tangkapan Layar" class="top-bar__title" />
        </ui:VisualElement>

        <ui:ScrollView name="scroll-main" 
                       vertical-scrollbar-visibility="Hidden"
                       horizontal-scrollbar-visibility="Hidden"
                       style="flex: 1; padding-left: 24px; padding-right: 24px; margin-bottom: 48px;">

            <!-- Preview screenshot -->
            <ui:VisualElement name="preview-screenshot"
                style="border-radius: 16px;
                                     height: 1000px;
                                     margin-top: 16px;
                                     margin-bottom: 24px;
                                     background-color: #2A2A2A;
                                     overflow: hidden;
                                     align-items: center;
                                     justify-content: center;">
                <ui:Label name="preview-placeholder"
                    text="[ Pratinjau ]"
                    class="text-caption" />
            </ui:VisualElement>

            <!-- Nama Proyek -->
            <ui:Label text="Simpan ke Proyek"
                class="section-header__title"
                style="margin-bottom: 12px;" />

            <ui:Label text="Nama Proyek"
                      class="text-body"
                      style="margin-bottom: 6px;" />

            <ui:VisualElement name="proyek-dropdown-trigger"
                              class="dropdown-trigger">
                <ui:Label name="label-proyek-selected"
                          text="Pilih atau buat proyek..."
                          class="dropdown-trigger__text
                                 dropdown-trigger__placeholder" />
                <ui:Label name="label-arrow"
                          text="∨"
                          class="dropdown-trigger__arrow" />
            </ui:VisualElement>

            <ui:VisualElement name="proyek-dropdown-list"
                              class="dropdown-list"
                              style="display: none;" />

            <ui:VisualElement name="new-proyek-container"
                              style="display: none; margin-top: 8px;">
                <ui:VisualElement class="search-bar"
                                  style="margin-left: 0;
                                         margin-right: 0;
                                         margin-bottom: 0;">
                    <ui:TextField name="input-proyek-baru"
                                  class="search-bar__input"
                                  placeholder-text="Nama proyek baru..." />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:ScrollView>

        <!-- Bottom actions -->
        <ui:VisualElement class="bottom-action"
            style="flex-direction: row;
                                 gap: 12px;
                                 flex-shrink: 0;">
            <ui:VisualElement name="btn-simpan-proyek"
                class="btn-ar"
                style="flex: 1; margin-top: 0;">
                <ui:Label text="Simpan ke Proyek"
                    class="btn-ar__label"
                    style="font-size: 22px;" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>