<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../USS/AppStyles.uss" />

    <ui:VisualElement name="screen-detail-furnitur" class="screen">

        <!-- Top Bar -->
        <ui:VisualElement class="top-bar">
            <ui:Label name="btn-back" class="btn-back" />
            <ui:Label text="Detail Furnitur" class="top-bar__title" />
        </ui:VisualElement>

        <!-- Scrollable body -->
        <ui:ScrollView name="scroll-main"
            vertical-scrollbar-visibility="Hidden"
            horizontal-scrollbar-visibility="Hidden"
            style="flex: 1;">

            <!-- Hero Preview -->
            <ui:VisualElement name="detail-hero" class="detail-hero">
                <!-- 
                <ui:VisualElement name="zoom-in"
                    style="position: absolute;
                            right: 32px;
                            bottom: 32px;
                            width: 80px;
                            height: 80px;
                            background-image: url('project://database/Assets/UI/Resources/zoom-in.svg');
                            -unity-background-scale-mode: scale-to-fit;" />
                -->
            </ui:VisualElement>

            <!-- Info -->
            <ui:VisualElement class="detail-body">
                <ui:Label name="label-name"
                    text="Nama Furnitur"
                    class="detail-name" />
                <ui:Label name="label-description"
                    text="Deskripsi furnitur akan tampil di sini."
                    class="detail-description" />

                <ui:VisualElement
                    style="width: 100%;
                              height: 5px;
                              border-radius: 12px;
                              background-color: #FFC800;
                              margin-bottom: 24px" />

                <!-- Spesifikasi -->
                <ui:Label text="Deskripsi"
                    class="text-body"
                    style="margin-bottom: 12px; -unity-font-style: bold;" />

                <ui:VisualElement class="spec-grid">
                    <ui:VisualElement class="spec-item">
                        <ui:Label text="Kategori"
                            class="spec-item__label" />
                        <ui:Label name="spec-kategori"
                            text="-"
                            class="spec-item__value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="spec-item">
                        <ui:Label text="Dimensi (cm)"
                            class="spec-item__label" />
                        <ui:Label name="spec-dimensi"
                            text="-"
                            class="spec-item__value" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:ScrollView>

        <!-- Fixed Bottom CTA -->
        <ui:VisualElement class="bottom-action">
            <ui:VisualElement name="btn-ar" class="btn-ar">
                <ui:Label text="Lihat di Ruanganmu →"
                    class="btn-ar__label" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>