<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../USS/AppStyles.uss" />

    <ui:VisualElement name="screen-detail-proyek" class="screen">

        <ui:VisualElement class="top-bar-project-detail">
            <ui:Label name="btn-back" class="btn-back" />
            <ui:VisualElement style="flex-direction: row; align-items: center;">
                <ui:Label name="btn-setting"
                    style="width: 50px;
                              height: 50px;
                              background-color: #FFC800;" />
                <ui:Label name="btn-setting"
                    style="width: 50px;
                              height: 50px;
                              background-color: #FFC800;
                              margin-left: 24px;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="label-nama-proyek"
            text="Nama Proyek"
            class="text-h2"
            style="padding-left: 24px;" />

        <!-- Tanggal -->
        <ui:Label name="label-tanggal"
            text="15 Juli 2025"
            class="text-body"
            style="padding-left: 24px; padding-bottom: 24px;" />

        <ui:VisualElement
            style="padding-left: 24px;
                              padding-right: 24px;">
            <ui:VisualElement
                style="width: 100%;
                              height: 5px;
                              border-radius: 12px;
                              background-color: #FFC800;
                              margin-bottom: 24px;" />
        </ui:VisualElement>

        <!-- Foto grid -->
        <ui:ScrollView vertical-scrollbar-visibility="Hidden"
            horizontal-scrollbar-visibility="Hidden"
            style="flex: 1;">

            <ui:VisualElement name="photo-grid" class="photo-grid">
                <!-- Diisi via script -->
            </ui:VisualElement>

            <!-- Empty state jika belum ada foto -->
            <ui:VisualElement name="photo-empty" class="empty-state"
                style="margin-left: 16px; margin-right: 16px;">
                <ui:Label text="Belum ada tangkapan layar"
                    class="empty-state__text" />
            </ui:VisualElement>

        </ui:ScrollView>

    </ui:VisualElement>
</ui:UXML>