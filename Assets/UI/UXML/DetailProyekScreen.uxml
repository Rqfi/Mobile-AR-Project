<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../USS/AppStyles.uss" />

    <ui:VisualElement name="screen-detail-proyek" class="screen">

        <ui:VisualElement class="top-bar-project-detail">
            <ui:Label name="btn-back" class="btn-back" />
            <ui:VisualElement style="flex-direction: row; align-items: center;">
                <ui:Label name="btn-setting"
                    style="width: 50px;
                                 height: 50px;
                                 background-image: url('project://database/Assets/UI/Resources/overflow-menu.svg');
                                 -unity-background-scale-mode: scale-to-fit;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="label-nama-proyek"
            text="Nama Proyek"
            class="text-h2"
            style="padding-left: 24px;" />

        <ui:Label name="label-tanggal"
            text="15 Juli 2025"
            class="text-body"
            style="padding-left: 24px; padding-bottom: 24px;" />

        <ui:VisualElement style="padding-left: 24px; padding-right: 24px;">
            <ui:VisualElement
                style="width: 100%;
                                     height: 5px;
                                     border-radius: 12px;
                                     background-color: #FFC800;
                                     margin-bottom: 24px;" />
        </ui:VisualElement>

        <!-- Foto grid -->
        <ui:ScrollView vertical-scrollbar-visibility="Hidden"
            horizontal-scrollbar-visibility="Hidden"
            style="flex: 1;">

            <ui:VisualElement name="photo-grid" class="photo-grid" />

            <ui:VisualElement name="photo-empty" class="empty-state"
                style="margin-left: 16px; margin-right: 16px;">
                <ui:Label text="Belum ada tangkapan layar"
                    class="empty-state__text" />
            </ui:VisualElement>

        </ui:ScrollView>

        <!-- Overlay gelap (backdrop) -->
        <ui:VisualElement name="menu-backdrop"
            style="position: absolute;
                                 top: 0; left: 0; right: 0; bottom: 0;
                                 background-color: rgba(0,0,0,0.5);
                                 display: none;" />

        <!-- Bottom sheet menu -->
        <ui:VisualElement name="bottom-sheet-menu"
            class="bottom-sheet"
            style="display: none;">
            <ui:VisualElement class="bottom-sheet__handle" />
            <ui:Label text="Opsi Proyek"
                class="bottom-sheet__title" />

            <ui:VisualElement name="btn-edit-nama"
                class="bottom-sheet__item">
                <ui:Label text="Edit Nama Proyek"
                    class="bottom-sheet__item-label" />
            </ui:VisualElement>

            <ui:VisualElement name="btn-hapus-proyek"
                class="bottom-sheet__item bottom-sheet__item--danger">
                <ui:Label text="Hapus Proyek"
                    class="bottom-sheet__item-label bottom-sheet__item-label--danger" />
            </ui:VisualElement>

            <ui:VisualElement name="btn-cancel-menu"
                class="bottom-sheet__item bottom-sheet__item--cancel">
                <ui:Label text="Batal"
                    class="bottom-sheet__item-label" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Modal Edit Nama -->
        <ui:VisualElement name="modal-edit"
            style="position: absolute;
                                 top: 0; left: 0; right: 0; bottom: 0;
                                 background-color: rgba(0,0,0,0.5);
                                 align-items: center;
                                 justify-content: center;
                                 display: none;">
            <ui:VisualElement class="modal-card">
                <ui:Label text="Edit Nama Proyek"
                    class="modal-card__title" />

                <ui:VisualElement class="search-bar"
                    style="margin-left: 0;
                                         margin-right: 0;
                                         margin-bottom: 24px;">
                    <ui:TextField name="input-edit-nama"
                        class="search-bar__input"
                        placeholder-text="Nama proyek baru..." />
                </ui:VisualElement>

                <ui:VisualElement style="flex-direction: row; gap: 12px;">
                    <ui:VisualElement name="btn-cancel-edit"
                        class="modal-card__btn modal-card__btn--secondary"
                        style="margin-right: 12px;">
                        <ui:Label text="Batal"
                            class="modal-card__btn-label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="btn-confirm-edit"
                        class="modal-card__btn modal-card__btn--primary"
                        style="margin-left: 12px;">
                        <ui:Label text="Simpan"
                            class="modal-card__btn-label" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Modal Konfirmasi Hapus -->
        <ui:VisualElement name="modal-hapus"
            style="position: absolute;
                                 top: 0; left: 0; right: 0; bottom: 0;
                                 background-color: rgba(0,0,0,0.5);
                                 align-items: center;
                                 justify-content: center;
                                 display: none;">
            <ui:VisualElement class="modal-card">
                <ui:Label text="Hapus Proyek?"
                    class="modal-card__title" />
                <ui:Label text="Semua tangkapan layar dalam proyek ini akan dihapus permanen."
                    class="modal-card__desc" />

                <ui:VisualElement style="flex-direction: row; gap: 12px; margin-top: 8px;">
                    <ui:VisualElement name="btn-cancel-hapus"
                        class="modal-card__btn modal-card__btn--secondary"
                        style="margin-right: 12px;">
                        <ui:Label text="Batal"
                            class="modal-card__btn-label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="btn-confirm-hapus"
                        class="modal-card__btn modal-card__btn--danger"
                        style="margin-left: 12px;">
                        <ui:Label text="Hapus"
                            class="modal-card__btn-label" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>